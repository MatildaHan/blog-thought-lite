---
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n";

const t = i18nit(config.i18n.defaultLocale);
---

<Base title="500">
	<main class="contents">
		<div class="inline-flex flex-col items-center justify-center gap-2 text-center grow-[0.5] animate-shaky">
			<span class="text-6xl font-bold">500</span>
			<span class="text-2xl font-bold">{t("error.server")}</span>
		</div>
		<a href="/" class="text-lg text-center link">&gt; {t("error.back")}</a>
	</main>
</Base>
